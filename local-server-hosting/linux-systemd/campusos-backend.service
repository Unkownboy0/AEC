[Unit]
Description=CampusOS Backend API Production Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=campusos
WorkingDirectory=/opt/campusos/product/server
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5000
EnvironmentFile=/opt/campusos/product/server/.env

# Security Sandbox options
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
