<?xml version="1.0" encoding="utf-8"?>
<!--
  CampusOS Network Security Configuration
  - HTTPS enforced for all production domains (no cleartext traffic)
  - HTTP allowed only for local development targets:
      localhost        → web dev server
      10.0.2.2        → Android emulator host (maps to host machine)
      192.168.*        → LAN testing via developer device
  Operators: Set VITE_SERVER_BASE_URL to an HTTPS endpoint for production builds.
-->
<network-security-config>
    <!-- Release/main policy: HTTPS only. Debug builds replace this resource. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
