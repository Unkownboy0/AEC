NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://campusos:change-me@localhost:5432/campusos
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_MINUTES=15
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
STORAGE_ROOT=./uploads
BACKUP_ROOT=./backups
PG_DUMP_PATH=pg_dump
TRUST_PROXY=0
PAYMENT_GATEWAY=DISABLED
# Stable tenant boundary used by delegated authority checks in single-tenant deployments.
CAMPUS_TENANT_ID=campusos-default
# ── Firebase Cloud Messaging (FCM) — Background Push Notifications ─────────────
# Required for true background and killed-state push delivery on Android and iOS.
# Without this, in-app notifications still work via polling, but device banners
# will NOT appear when the app is backgrounded or killed.
#
# SETUP STEPS:
#   1. Go to https://console.firebase.google.com → project "campusos-db831"
#   2. Project Settings → Service Accounts tab
#   3. Click "Generate new private key" → download the JSON file
#   4. Set ONE of the two options below:
#
# Option A — inline JSON (preferred for Docker / CI environments):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"campusos-db831",...}
#
# Option B — file path (preferred for local development):
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account-key.json

# Set EMAIL_PROVIDER=SMTP and fill in the SMTP_* values to enable password-reset
# and other transactional emails. Left DISABLED, those emails are only logged.
EMAIL_PROVIDER=DISABLED
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GEETORUS CAMPUSOS <no-reply@campusos.local>"
