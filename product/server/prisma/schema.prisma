model IqacRequirement {
  id          String         @id @default(uuid())
  auditId     String
  audit       IqacAudit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  title       String
  description String?
  criterion   String?
  keyIndicator String?
  metricCode  String?
  sourceType  String?
  isRequired  Boolean        @default(true)
  evidence    IqacEvidence[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([auditId])
  @@map("iqac_requirements")
}

model IqacEvidence {
  id               String            @id @default(uuid())
  auditId          String
  audit            IqacAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requirementId    String
  requirement      IqacRequirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       User              @relation("IqacEvidenceUploader", fields: [uploadedById], references: [id])
  fileReference    String
  originalFileName String
  mimeType         String
  fileSize         Int
  sourceType       String            @default("UPLOAD")
  sourceEntityId   String?
  repositoryKey    String?
  version          Int               @default(1)
  isCurrent        Boolean           @default(true)
  status           String            @default("UPLOADED") // UPLOADED, UNDER_REVIEW, VERIFIED, REJECTED, CORRECTION_REQUIRED, RESUBMITTED, CLOSED
  submittedAt      DateTime          @default(now())
  reviewedById     String?
  reviewedBy       User?             @relation("IqacEvidenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  remarks          String?
  observations     IqacObservation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([auditId, departmentId, requirementId, version])
  @@index([departmentId, status])
  @@index([requirementId])
  @@index([repositoryKey])
  @@map("iqac_evidence")
}

model IqacObservation {
  id         String        @id @default(uuid())
  auditId    String
  audit      IqacAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  evidenceId String?
  evidence   IqacEvidence? @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation("IqacObservationAuthor", fields: [authorId], references: [id])
  category   String        @default("OBSERVATION")
