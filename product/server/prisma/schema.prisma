  supportUrl      String?
  metadataJson    String?
  studentId       String?
  student         Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  billId          String?
  bill            FeeBill? @relation(fields: [billId], references: [id], onDelete: Restrict)
  paymentId       String?
  payment         FeePayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedById   String
  requestedBy     User @relation("FinanceRequestCreator", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById    String?
  reviewedBy      User? @relation("FinanceRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?
