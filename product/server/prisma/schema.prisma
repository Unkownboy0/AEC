datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String
  firstName               String
  lastName                String
  phone                   String?
  designation             String?
  departmentId            String?
  reportingManagerId      String?
  workspaces              String? // JSON array of accessible workspaces
  activeWorkspace         String? // Active workspace identifier
  approvalAuthority       Boolean   @default(false)
  dashboardConfig         String? // JSON user-level dashboard override
  notificationPreferences String? // JSON preferences
  status                  String    @default("ACTIVE") // ACTIVE, BLOCKED, INACTIVE, SUSPENDED
  gender                  String?
  dob                     DateTime?
  bloodGroup              String?
  digitalSignature        String?
  qrCode                  String?
  aadhaarNumber           String?
  emergencyContact        String?
  qualification           String?
  experience              String?
  skills                  String?
  certificates            String?
  profileCompletion       Int       @default(0)
  joiningDate             DateTime?
  accountStatus           String    @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  loginStatus             String    @default("OFFLINE") // ONLINE, OFFLINE
  activityTimeline        String? // JSON timeline events
  designationId           String?
  parentRoleId            String?

  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  assignedRoles       UserRole[]
  userWorkspaces      UserWorkspace[]
  committees          UserCommittee[]
  sessions            UserSession[]
  resetTokens         PasswordResetToken[]
  histories           LoginHistory[]
  activities          UserActivityLog[]
  student             Student?
  faculty             Faculty?
  lockedUntil         DateTime?
  failedLoginAttempts Int                  @default(0)
  forcePasswordChange Boolean              @default(false)
  profilePhoto        String?
  passwordChangedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  username             String?                  @unique
  createdCirculars     HodCircular[]            @relation("CircularCreator")
  circularReadTrackers HodCircularReadTracker[] @relation("UserCircularReadTracker")
  publishedTimetables  MasterTimetable[]        @relation("TimetablePublisher")

  departmentMemberships    DepartmentMembership[]
  createdTasks             Task[]                    @relation("TaskCreator")
  assignedTasks            TaskAssignee[]
  taskStatusHistories      TaskStatusHistory[]
  taskComments             TaskComment[]
  commentMentions          TaskCommentMention[]
  commentReadReceipts      CommentReadReceipt[]
  uploadedAttachments      Attachment[]
  uploadedFileVersions     FileVersion[]
  receivedNotifications    Notification[]            @relation("NotificationRecipient")
  notificationPrefs        NotificationPreference?
  deviceTokens             DeviceToken[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  messageReadReceipts      MessageReadReceipt[]
  presence                 UserPresence?
  auditLogs                AuditLog[]                @relation("AuditLogActor")
  parentProfile            ParentProfile?
  authoredCirculars        InstitutionalCircular[]   @relation("CircularAuthor")
  circularReadReceipts     CircularReadReceipt[]
  profileChangeRequests    ProfileChangeRequest[]
  savedReports             SavedReport[]

  // Academic Task & Admission Coordination Relations
  createdAcademicTasks       AcademicTask[]                 @relation("AcademicTaskCreator")
  assignedAcademicTasks      AcademicTaskAssignment[]       @relation("AcademicTaskHod")
  createdAcademicAssignments AcademicTaskAssignment[]       @relation("AcademicTaskAssigner")
  uploadedAcademicFiles      AcademicTaskFile[]             @relation("AcademicTaskFileUploader")
  authoredAcademicQueries    AcademicTaskQuery[]            @relation("AcademicTaskQueryAuthor")
  resolvedAcademicQueries    AcademicTaskQuery[]            @relation("AcademicTaskQueryResolver")
  submittedAcademicTasks     AcademicTaskSubmission[]       @relation("AcademicTaskSubmitter")
  reviewedAcademicTasks      AcademicTaskSubmission[]       @relation("AcademicTaskReviewer")
  timelineAcademicEvents     AcademicTaskTimeline[]         @relation("AcademicTaskTimelineActor")
  createdAcademicTemplates   AcademicTaskTemplate[]         @relation("AcademicTaskTemplateCreator")
  assignedAdmissionRequests  AdmissionCoordinationRequest[] @relation("AdmissionCoordinationHod")
  reviewedAdmissionRequests  AdmissionCoordinationRequest[] @relation("AdmissionCoordinationReviewer")
  createdAdmissionRequests   AdmissionCoordinationRequest[] @relation("AdmissionCoordinationCreator")
  hodAssignments             DepartmentHodAssignment[]
  createdIqacAudits          IqacAudit[]                    @relation("IqacAuditCreator")
  uploadedIqacEvidence       IqacEvidence[]                 @relation("IqacEvidenceUploader")
  reviewedIqacEvidence       IqacEvidence[]                 @relation("IqacEvidenceReviewer")
  authoredIqacObservations   IqacObservation[]              @relation("IqacObservationAuthor")
  iqacTimelineEvents         IqacAuditTimeline[]            @relation("IqacTimelineActor")
  assignedTickets            Ticket[]                       @relation("TicketAssignee")
  financeLedgerEntries       FinanceLedgerEntry[]            @relation("FinanceLedgerCreator")
  accountantClosings         DailyClosing[]                  @relation("FinanceClosingAccountant")
  reviewedClosings           DailyClosing[]                  @relation("FinanceClosingReviewer")
  closingApprovalActions     DailyClosingApproval[]          @relation("FinanceClosingApprovalActor")
  financeRequestsCreated     FinanceRequest[]                @relation("FinanceRequestCreator")
  financeRequestsReviewed    FinanceRequest[]                @relation("FinanceRequestReviewer")
  reconciliationAssignments FinanceReconciliation[]         @relation("FinanceReconciliationAssignee")
  financeAuditActions        FinancialAuditLog[]             @relation("FinancialAuditActor")

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@map("users")
}

model UsernameCounter {
  id         String   @id @default(uuid())
  rolePrefix String
  year       Int
  counter    Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([rolePrefix, year])
  @@map("username_counters")
}

model Role {
  id                   String           @id @default(uuid())
  name                 String           @unique
  roleCode             String?          @unique
  description          String?
  color                String           @default("#6366f1")
  icon                 String           @default("Shield")
  priority             Int              @default(0)
  hierarchy            Int              @default(99)
  isSystem             Boolean          @default(false)
  status               String           @default("ACTIVE") // ACTIVE, ARCHIVED, INACTIVE
  departmentId         String?
  dashboardConfig      String? // JSON widget config
  sidebarConfig        String? // JSON sidebar visibility
  moduleAccess         String? // JSON module permissions matrix
  approvalLevels       String? // JSON approval rules
  reportAccess         String? // JSON report permissions
  workspaceAccess      String? // JSON workspaces list
  notificationSettings String? // JSON notification toggles
  searchScope          String?          @default("EVERYONE") // EVERYONE, OWN_DEPARTMENT, ASSIGNED_STUDENTS, OWN_PROFILE, OWN_CHILD
  createdBy            String?
  users                User[]
  userRoles            UserRole[]
  permissions          RolePermission[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("roles")
}

model UserRole {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model Designation {
  id           String   @id @default(uuid())
  title        String   @unique
  code         String   @unique
  description  String?
  hierarchy    Int      @default(99)
  departmentId String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("designations")
}

model Committee {
  id                    String          @id @default(uuid())
  name                  String          @unique
  code                  String          @unique
  type                  String          @default("ACADEMIC") // IQAC, NAAC, NBA, NIRF, PLACEMENT, ANTI_RAGGING, DISCIPLINARY, SPORTS, RESEARCH, INNOVATION
  description           String?
  status                String          @default("ACTIVE")
  additionalPermissions String? // JSON string matrix
  members               UserCommittee[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("committees")
}

model UserCommittee {
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  committeeId     String
  committee       Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  roleInCommittee String    @default("MEMBER") // CHAIRPERSON, CONVENOR, MEMBER, SECRETARY
  joinedAt        DateTime  @default(now())

  @@id([userId, committeeId])
  @@map("user_committees")
}

model PermissionDelegation {
  id                String   @id @default(uuid())
  delegatorId       String
  delegateeId       String
  roleId            String?
  customPermissions String? // JSON matrix override
  reason            String
  startDate         DateTime
  endDate           DateTime
  status            String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([delegatorId])
  @@index([delegateeId])
  @@map("permission_delegations")
}

model UserWorkspace {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceCode String // e.g. "FACULTY", "HOD", "MENTOR", "IQAC", "ADMISSION", "ADMINISTRATION"
  workspaceName String // e.g. "Faculty Workspace", "HOD Workspace"
  roleName      String // Matching role name for permissions context
  isPrimary     Boolean  @default(false)
  status        String   @default("ACTIVE")
  assignedAt    DateTime @default(now())

  @@unique([userId, workspaceCode])
  @@index([userId])
  @@map("user_workspaces")
}

model RbacAuditLog {
  id            String   @id @default(uuid())
  entityType    String // USER, ROLE, PERMISSION, DELEGATION, COMMITTEE, WORKFLOW
  entityId      String
  action        String // CREATE, UPDATE, DELETE, GRANT, REVOKE, DELEGATE
  oldValue      String? // JSON
  newValue      String? // JSON
  changedBy     String
  reason        String?
  ipAddress     String?
  userAgent     String?
  device        String?
  browser       String?
  affectedUsers String? // JSON array of user IDs
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([changedBy])
  @@map("rbac_audit_logs")
}

model PermissionGroup {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String       @unique
  description String?
  icon        String?
  sortOrder   Int          @default(0)
  status      String       @default("ACTIVE")
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("permission_groups")
}

model PermissionAudit {
  id            String   @id @default(uuid())
  userId        String
  roleId        String?
  permissionId  String?
  action        String
  previousValue String?
  newValue      String?
  endpoint      String?
  result        String
  ipAddress     String?
  userAgent     String?
  device        String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("permission_audits")
}

model Permission {
  id          String                      @id @default(uuid())
  name        String                      @unique
  module      String                      @default("GENERAL")
  action      String                      @default("VIEW")
  description String?
  groupId     String?
  group       PermissionGroup?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  roles       RolePermission[]
  templates   PermissionTemplateMapping[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  device       String?
  browser      String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("user_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model LoginHistory {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginTime  DateTime  @default(now())
  logoutTime DateTime?
  ipAddress  String?
  userAgent  String?
  device     String?
  browser    String?
  status     String // SUCCESS, FAILED
  createdAt  DateTime  @default(now())

  @@index([userId, status])
  @@index([createdAt])
  @@map("login_history")
}

// ==========================================
// PHASE 3 - SUPER ADMIN CONFIGURATION TABLES
// ==========================================

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "SMTP_HOST", "COLLEGE_NAME", "BRAND_COLOR"
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ==========================================
// PLATFORM CONTROL CENTER - FEATURE FLAG ENGINE
// ==========================================

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique // e.g. "module.iqac", "feature.parent.portal"
  name           String
  description    String?
  category       String   @default("feature") // module | feature | addon
  status         String   @default("STABLE") // STABLE | BETA | EXPERIMENTAL | DEPRECATED
  defaultEnabled Boolean  @default(false)
  rolloutPercent Int      @default(100) // gradual rollout once defaultEnabled is true
  startAt        DateTime? // scheduled activation
  endAt          DateTime? // scheduled expiry
  config         String? // JSON payload for feature-specific limits/config
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id           String      @id @default(uuid())
  flagId       String
  flag         FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  scope        String // DEPARTMENT | ROLE | USER
  departmentId String?
  roleName     String?
  userId       String?
  enabled      Boolean
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([flagId])
  @@map("feature_flag_overrides")
}

model AcademicYear {
  id                 String              @id @default(uuid())
  name               String              @unique // e.g. "2026-2027"
  status             String              @default("INACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  startDate          DateTime
  endDate            DateTime
  isCurrent          Boolean             @default(false)
  archived           Boolean             @default(false)
  archivedAt         DateTime?
  deleted            Boolean             @default(false)
  deletedAt          DateTime?
  departments        Department[]
  semesters          Semester[]
  students           Student[]
  exams              Exam[]
  timetableSlots     TimetableSlot[]
  subjectAssignments SubjectAssignment[]
  assignments        Assignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  MentorAssignment   MentorAssignment[]
  teachingGroups     TeachingGroup[]

  @@map("academic_years")
}

model Department {
  id              String  @id @default(uuid())
  name            String  @unique // e.g. "Computer Science & Engineering"
  code            String  @unique // e.g. "CSE"
  shortName       String?
  description     String?
  type            String  @default("Engineering") // Engineering, Arts, Science, Medical, Management, Commerce
  status          String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  logo            String?
  banner          String?
  color           String  @default("#6366f1")
  email           String?
  phone           String?
  website         String?
  officeLocation  String?
  establishedYear Int?
  hodId           String?
  hodUserId       String?
  hodName         String?
  documents       String  @default("[]") // JSON string of documents

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  programs        Program[]
  courses         Course[]
  sections        Section[]
  subjects        Subject[]
  students        Student[]
  programStudents Student[]       @relation("ProgramDepartment")
  faculties       Faculty[]
  timetableSlots  TimetableSlot[]
  assignments     Assignment[]

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  MentorAssignment              MentorAssignment[]
  circulars                     HodCircular[]
  admissionApplications         AdmissionApplication[]
  departmentIntake              DepartmentIntake?
  memberships                   DepartmentMembership[]
  tasks                         Task[]
  facultyLeaveRequests          FacultyLeaveRequest[]
  institutionalCirculars        InstitutionalCircular[]
  academicTaskAssignments       AcademicTaskAssignment[]       @relation("AcademicTaskDepartment")
  academicTaskTimelineEvents    AcademicTaskTimeline[]         @relation("AcademicTaskTimelineDepartment")
  admissionCoordinationRequests AdmissionCoordinationRequest[] @relation("AdmissionCoordinationDepartment")
  hodAssignments                DepartmentHodAssignment[]
  teachingGroupMemberships      TeachingGroupDepartment[]
  iqacAuditAssignments          IqacAuditDepartment[]
  iqacEvidence                  IqacEvidence[]

  @@map("departments")
}

model Program {
  id          String  @id @default(uuid())
  name        String // e.g. "Bachelor of Technology"
  code        String // e.g. "B.Tech"
  duration    Int     @default(4) // e.g. 4 years
  level       String  @default("UG") // e.g. UG, PG
  credits     Int     @default(160)
  status      String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  coordinator String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  courses     Course[]
  semesters   Semester[]
  sections    Section[]
  subjects    Subject[]
  students    Student[]
  assignments Assignment[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  MentorAssignment      MentorAssignment[]
  admissionApplications AdmissionApplication[]

  @@unique([name, departmentId])
  @@index([departmentId])
  @@map("programs")
}

model Course {
  id             String  @id @default(uuid())
  name           String // e.g. "Computer Science & Engineering"
  code           String // e.g. "CSE"
  duration       Int // in years
  credits        Int     @default(160)
  regulation     String  @default("R26") // e.g. R26
  coordinator    String?
  description    String?
  status         String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  courseOutcomes String  @default("[]") // JSON string of outcomes

  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  semesters Semester[]
  students  Student[]
  exams     Exam[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([name, programId])
  @@index([programId])
  @@index([departmentId])
  @@map("courses")
}

model Semester {
  id        String   @id @default(uuid())
  number    Int // e.g. 1, 2, 3
  name      String // e.g. "Semester 1"
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  isCurrent Boolean  @default(false)
  credits   Int      @default(20)

  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  sections           Section[]
  subjects           Subject[]
  students           Student[]
  exams              Exam[]
  timetableSlots     TimetableSlot[]
  subjectAssignments SubjectAssignment[]
  assignments        Assignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  MentorAssignment   MentorAssignment[]

  @@unique([number, courseId])
  @@index([courseId])
  @@index([programId])
  @@index([academicYearId])
  @@map("semesters")
}

model Section {
  id           String  @id @default(uuid())
  name         String // e.g. "Section A"
  capacity     Int     @default(60)
  classAdvisor String?
  room         String?
  status       String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED

  semesterId   String
  semester     Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  subjects                 Subject[]
  students                 Student[]
  timetableSlots           TimetableSlot[]
  subjectAssignments       SubjectAssignment[]
  assignments              Assignment[]
  teachingGroupMemberships TeachingGroupSection[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  MentorAssignment         MentorAssignment[]

  @@unique([name, semesterId])
  @@index([semesterId])
  @@index([programId])
  @@index([departmentId])
  @@map("sections")
}

model Subject {
  id                     String      @id @default(uuid())
  name                   String
  code                   String      @unique
  credits                Int         @default(3)
  theoryHours            Int         @default(3)
  practicalHours         Int         @default(0)
  tutorialHours          Int         @default(0)
  internalMarks          Int         @default(40)
  externalMarks          Int         @default(60)
  passingMarks           Int         @default(40)
  isElective             Boolean     @default(false)
  isLab                  Boolean     @default(false)
  isCore                 Boolean     @default(true)
  isSkillBased           Boolean     @default(false)
  isOpenElective         Boolean     @default(false)
  isProfessionalElective Boolean     @default(false)
  subjectCoordinator     String?
  regulationId           String?
  regulation             Regulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  approvalStatus         String      @default("DRAFT") // DRAFT, SUBMITTED_TO_HOD, HOD_APPROVED, DEAN_APPROVED, PUBLISHED
  assignedFacultyId      String?
  assignedFaculty        Faculty?    @relation(fields: [assignedFacultyId], references: [id], onDelete: SetNull)
  assignedHodId          String?
  assignedDeanId         String?
  assignedCoordinatorId  String?

  description String?
  status      String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED

  semesterId   String
  semester     Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  attendances        Attendance[]
  marks              Mark[]
  timetableSlots     TimetableSlot[]
  subjectAssignments SubjectAssignment[]
  assignments        Assignment[]
  teachingGroups     TeachingGroup[]

  courseOutcomes    CourseOutcome[]
  curriculumUnits   CurriculumUnit[]
  materials         CurriculumMaterial[]
  questionBankItems QuestionBankItem[]
  labExperiments    LabExperiment[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semesterId])
  @@index([departmentId])
  @@index([programId])
  @@index([sectionId])
  @@index([regulationId])
  @@map("subjects")
}

model Regulation {
  id            String    @id @default(uuid())
  code          String    @unique // e.g. "R2021", "R2023", "R2026"
  title         String // e.g. "Regulations 2026 Choice Based Credit System"
  effectiveYear String // e.g. "2026-27"
  status        String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  version       Int       @default(1)
  isCurrent     Boolean   @default(false)
  description   String?
  subjects      Subject[]
  deleted       Boolean   @default(false)
  deletedAt     DateTime?
