  id             String   @id @default(uuid())
  entryNumber    String   @unique
  entryType      String   // PAYMENT, REFUND, ADJUSTMENT, CONCESSION, SCHOLARSHIP
  direction      String   // DEBIT, CREDIT
  amount         Float
  currency       String   @default("INR")
  description    String
  paymentId      String?
  payment        FeePayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  billId         String?
  bill           FeeBill? @relation(fields: [billId], references: [id], onDelete: Restrict)
  studentId      String
  student        Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User @relation("FinanceLedgerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sourceType     String
  sourceId       String
  metadataJson   String?
  postedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([sourceType, sourceId, entryType])
  @@index([studentId, postedAt])
  @@index([billId, postedAt])
  @@index([paymentId])
  @@map("finance_ledger_entries")
}

model DailyClosing {
  id              String   @id @default(uuid())
  closingNumber   String   @unique
  closingDate     DateTime @db.Date
  accountantId    String
  accountant      User @relation("FinanceClosingAccountant", fields: [accountantId], references: [id], onDelete: Restrict)
  expectedTotal   Float
  actualTotal     Float
  onlineTotal     Float
  offlineTotal    Float
  cashTotal       Float
  upiTotal        Float
  bankTotal       Float
  chequeTotal     Float
  ddTotal         Float
  refundTotal     Float
  adjustmentTotal Float
  difference      Float
  cashCount       Float?
  remarks         String?
  supportUrl      String?
  snapshotJson    String
  status          String   @default("DRAFT") // DRAFT, SUBMITTED_TO_AO, AO_APPROVED, AO_RETURNED, QUERY_RAISED
  submittedAt     DateTime?
  reviewedById    String?
  reviewedBy      User? @relation("FinanceClosingReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?
  returnReason    String?
  approvals       DailyClosingApproval[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([accountantId, closingDate])
  @@index([status, closingDate])
  @@map("daily_closings")
}

model DailyClosingApproval {
  id          String   @id @default(uuid())
  closingId   String
  closing     DailyClosing @relation(fields: [closingId], references: [id], onDelete: Restrict)
