  dependencyType    String   @default("FINISH_TO_START") // FINISH_TO_START, START_TO_START, FINISH_TO_FINISH
  createdAt         DateTime @default(now())

  @@unique([predecessorTaskId, successorTaskId])
  @@map("task_dependencies")
}

model TaskTemplate {
