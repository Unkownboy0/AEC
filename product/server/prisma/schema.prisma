  actor        User @relation("FinancialAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorRole    String
  action       String
  resourceType String
  resourceId   String
  beforeJson   String?
  afterJson    String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

