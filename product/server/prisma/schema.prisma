model IqacAudit {
  id           String                @id @default(uuid())
  auditCode    String                @unique
  title        String
  auditType    String
  description  String?
  status       String                @default("DRAFT") // DRAFT, REQUESTED, IN_PROGRESS, CORRECTION_REQUIRED, VERIFIED, CLOSED, CANCELLED
  startAt      DateTime?
  dueAt        DateTime?
  createdById  String
  createdBy    User                  @relation("IqacAuditCreator", fields: [createdById], references: [id])
  departments  IqacAuditDepartment[]
  requirements IqacRequirement[]
  evidence     IqacEvidence[]
  observations IqacObservation[]
