datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  designation         String?
  departmentId        String?
  reportingManagerId  String?
  workspaces          String?              // JSON array of accessible workspaces
  activeWorkspace     String?              // Active workspace identifier
  approvalAuthority   Boolean              @default(false)
  dashboardConfig     String?              // JSON user-level dashboard override
  notificationPreferences String?           // JSON preferences
  status              String               @default("ACTIVE") // ACTIVE, BLOCKED, INACTIVE, SUSPENDED
  gender              String?
  dob                 DateTime?
  bloodGroup          String?
  digitalSignature    String?
  qrCode              String?
  aadhaarNumber       String?
  emergencyContact    String?
  qualification       String?
  experience          String?
  skills              String?
  certificates        String?
  profileCompletion   Int                  @default(0)
  joiningDate         DateTime?
  accountStatus       String               @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  loginStatus         String               @default("OFFLINE") // ONLINE, OFFLINE
  activityTimeline    String?              // JSON timeline events
  designationId       String?
  parentRoleId        String?

  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  assignedRoles       UserRole[]
  committees          UserCommittee[]
  sessions            UserSession[]
  resetTokens         PasswordResetToken[]
  histories           LoginHistory[]
  activities          UserActivityLog[]
  student             Student?
  faculty             Faculty?
  lockedUntil         DateTime?
  failedLoginAttempts Int                  @default(0)
  forcePasswordChange Boolean              @default(false)
  profilePhoto        String?
  passwordChangedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  username            String?              @unique
  createdCirculars     HodCircular[]            @relation("CircularCreator")
  circularReadTrackers HodCircularReadTracker[] @relation("UserCircularReadTracker")
  publishedTimetables  MasterTimetable[]        @relation("TimetablePublisher")

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@map("users")
}

model UsernameCounter {
  id        String   @id @default(uuid())
  rolePrefix String
  year      Int
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([rolePrefix, year])
  @@map("username_counters")
}

model Role {
  id                   String           @id @default(uuid())
  name                 String           @unique
  roleCode             String?          @unique
  description          String?
  color                String           @default("#6366f1")
  icon                 String           @default("Shield")
  priority             Int              @default(0)
  hierarchy            Int              @default(99)
  isSystem             Boolean          @default(false)
  status               String           @default("ACTIVE") // ACTIVE, ARCHIVED, INACTIVE
  departmentId         String?
  dashboardConfig      String?          // JSON widget config
  sidebarConfig        String?          // JSON sidebar visibility
  moduleAccess         String?          // JSON module permissions matrix
  approvalLevels       String?          // JSON approval rules
  reportAccess         String?          // JSON report permissions
  workspaceAccess      String?          // JSON workspaces list
  notificationSettings String?          // JSON notification toggles
  searchScope          String?          @default("EVERYONE") // EVERYONE, OWN_DEPARTMENT, ASSIGNED_STUDENTS, OWN_PROFILE, OWN_CHILD
  createdBy            String?
  users                User[]
  userRoles            UserRole[]
  permissions          RolePermission[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("roles")
}

model UserRole {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model Designation {
  id           String   @id @default(uuid())
  title        String   @unique
  code         String   @unique
  description  String?
  hierarchy    Int      @default(99)
  departmentId String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("designations")
}

model Committee {
  id                    String          @id @default(uuid())
  name                  String          @unique
  code                  String          @unique
  type                  String          @default("ACADEMIC") // IQAC, NAAC, NBA, NIRF, PLACEMENT, ANTI_RAGGING, DISCIPLINARY, SPORTS, RESEARCH, INNOVATION
  description           String?
  status                String          @default("ACTIVE")
  additionalPermissions String?         // JSON string matrix
  members               UserCommittee[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("committees")
}

model UserCommittee {
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  committeeId     String
  committee       Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  roleInCommittee String    @default("MEMBER") // CHAIRPERSON, CONVENOR, MEMBER, SECRETARY
  joinedAt        DateTime  @default(now())

  @@id([userId, committeeId])
  @@map("user_committees")
}

model PermissionDelegation {
  id                String   @id @default(uuid())
  delegatorId       String
  delegateeId       String
  roleId            String?
  customPermissions String?  // JSON matrix override
  reason            String
  startDate         DateTime
  endDate           DateTime
  status            String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([delegatorId])
  @@index([delegateeId])
  @@map("permission_delegations")
}

model RbacAuditLog {
  id            String   @id @default(uuid())
  entityType    String   // USER, ROLE, PERMISSION, DELEGATION, COMMITTEE, WORKFLOW
  entityId      String
  action        String   // CREATE, UPDATE, DELETE, GRANT, REVOKE, DELEGATE
  oldValue      String?  // JSON
  newValue      String?  // JSON
  changedBy     String
  reason        String?
  ipAddress     String?
  userAgent     String?
  device        String?
  browser       String?
  affectedUsers String?  // JSON array of user IDs
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([changedBy])
  @@map("rbac_audit_logs")
}

model Permission {
  id          String                      @id @default(uuid())
  name        String                      @unique
  module      String                      @default("GENERAL")
  action      String                      @default("VIEW")
  description String?
  roles       RolePermission[]
  templates   PermissionTemplateMapping[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  device       String?
  browser      String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("user_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model LoginHistory {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginTime  DateTime  @default(now())
  logoutTime DateTime?
  ipAddress  String?
  userAgent  String?
  device     String?
  browser    String?
  status     String // SUCCESS, FAILED
  createdAt  DateTime  @default(now())

  @@index([userId, status])
  @@index([createdAt])
  @@map("login_history")
}

// ==========================================
// PHASE 3 - SUPER ADMIN CONFIGURATION TABLES
// ==========================================

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "SMTP_HOST", "COLLEGE_NAME", "BRAND_COLOR"
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model AcademicYear {
  id                 String              @id @default(uuid())
  name               String              @unique // e.g. "2026-2027"
  status             String              @default("INACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  startDate          DateTime
  endDate            DateTime
  isCurrent          Boolean             @default(false)
  archived           Boolean             @default(false)
  archivedAt         DateTime?
  deleted            Boolean             @default(false)
  deletedAt          DateTime?
  departments        Department[]
  semesters          Semester[]
  students           Student[]
  exams              Exam[]
  timetableSlots     TimetableSlot[]
  subjectAssignments SubjectAssignment[]
  assignments        Assignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  MentorAssignment   MentorAssignment[]

  @@map("academic_years")
}

model Department {
  id              String  @id @default(uuid())
  name            String  @unique // e.g. "Computer Science & Engineering"
  code            String  @unique // e.g. "CSE"
  shortName       String?
  description     String?
  type            String  @default("Engineering") // Engineering, Arts, Science, Medical, Management, Commerce
  status          String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  logo            String?
  banner          String?
  color           String  @default("#6366f1")
  email           String?
  phone           String?
  website         String?
  officeLocation  String?
  establishedYear Int?
  hodId           String?
  hodName         String?
  documents       String  @default("[]") // JSON string of documents

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  programs       Program[]
  courses        Course[]
  sections       Section[]
  subjects       Subject[]
  students       Student[]
  programStudents Student[] @relation("ProgramDepartment")
  faculties      Faculty[]
  timetableSlots TimetableSlot[]
  assignments    Assignment[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  MentorAssignment MentorAssignment[]
  circulars        HodCircular[]
  admissionApplications AdmissionApplication[]
  departmentIntake      DepartmentIntake?

  @@map("departments")
}

model Program {
  id          String  @id @default(uuid())
  name        String // e.g. "Bachelor of Technology"
  code        String // e.g. "B.Tech"
  duration    Int     @default(4) // e.g. 4 years
  level       String  @default("UG") // e.g. UG, PG
  credits     Int     @default(160)
  status      String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  coordinator String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  courses     Course[]
  semesters   Semester[]
  sections    Section[]
  subjects    Subject[]
  students    Student[]
  assignments Assignment[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  MentorAssignment MentorAssignment[]
  admissionApplications AdmissionApplication[]

  @@unique([name, departmentId])
  @@index([departmentId])
  @@map("programs")
}

model Course {
  id             String  @id @default(uuid())
  name           String // e.g. "Computer Science & Engineering"
  code           String // e.g. "CSE"
  duration       Int // in years
  credits        Int     @default(160)
  regulation     String  @default("R26") // e.g. R26
  coordinator    String?
  description    String?
  status         String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  courseOutcomes String  @default("[]") // JSON string of outcomes

  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  semesters Semester[]
  students  Student[]
  exams     Exam[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([name, programId])
  @@index([programId])
  @@index([departmentId])
  @@map("courses")
}

model Semester {
  id        String   @id @default(uuid())
  number    Int // e.g. 1, 2, 3
  name      String // e.g. "Semester 1"
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  isCurrent Boolean  @default(false)
  credits   Int      @default(20)

  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  sections           Section[]
  subjects           Subject[]
  students           Student[]
  exams              Exam[]
  timetableSlots     TimetableSlot[]
  subjectAssignments SubjectAssignment[]
  assignments        Assignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  MentorAssignment   MentorAssignment[]

  @@unique([number, courseId])
  @@index([courseId])
  @@index([programId])
  @@index([academicYearId])
  @@map("semesters")
}

model Section {
  id           String  @id @default(uuid())
  name         String // e.g. "Section A"
  capacity     Int     @default(60)
  classAdvisor String?
  room         String?
  status       String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED

  semesterId   String
  semester     Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  subjects           Subject[]
  students           Student[]
  timetableSlots     TimetableSlot[]
  subjectAssignments SubjectAssignment[]
  assignments        Assignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  MentorAssignment   MentorAssignment[]

  @@unique([name, semesterId])
  @@index([semesterId])
  @@index([programId])
  @@index([departmentId])
  @@map("sections")
}

model Subject {
  id                     String  @id @default(uuid())
  name                   String
  code                   String  @unique
  credits                Int     @default(3)
  theoryHours            Int     @default(3)
  practicalHours         Int     @default(0)
  tutorialHours          Int     @default(0)
  internalMarks          Int     @default(40)
  externalMarks          Int     @default(60)
  passingMarks           Int     @default(40)
  isElective             Boolean @default(false)
  isLab                  Boolean @default(false)
  isCore                 Boolean @default(true)
  isSkillBased           Boolean @default(false)
  isOpenElective         Boolean @default(false)
  isProfessionalElective Boolean @default(false)
  subjectCoordinator     String?
  regulationId           String?
  regulation             Regulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  approvalStatus         String  @default("DRAFT") // DRAFT, SUBMITTED_TO_HOD, HOD_APPROVED, DEAN_APPROVED, PUBLISHED
  assignedFacultyId      String?
  assignedFaculty        Faculty? @relation(fields: [assignedFacultyId], references: [id], onDelete: SetNull)
  assignedHodId          String?
  assignedDeanId         String?
  assignedCoordinatorId  String?

  description            String?
  status                 String  @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED

  semesterId   String
  semester     Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  attendances        Attendance[]
  marks              Mark[]
  timetableSlots     TimetableSlot[]
  subjectAssignments SubjectAssignment[]
  assignments        Assignment[]

  courseOutcomes     CourseOutcome[]
  curriculumUnits    CurriculumUnit[]
  materials          CurriculumMaterial[]
  questionBankItems  QuestionBankItem[]
  labExperiments     LabExperiment[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semesterId])
  @@index([departmentId])
  @@index([programId])
  @@index([sectionId])
  @@index([regulationId])
  @@map("subjects")
}

model Regulation {
  id            String    @id @default(uuid())
  code          String    @unique // e.g. "R2021", "R2023", "R2026"
  title         String    // e.g. "Regulations 2026 Choice Based Credit System"
  effectiveYear String    // e.g. "2026-27"
  status        String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  version       Int       @default(1)
  isCurrent     Boolean   @default(false)
  description   String?
  subjects      Subject[]
  deleted       Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("regulations")
}

model ProgramOutcome {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "PO1", "PO2"
  title       String   // e.g. "Engineering Knowledge"
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("program_outcomes")
}

model ProgramSpecificOutcome {
  id           String   @id @default(uuid())
  code         String   // e.g. "PSO1"
  departmentId String
  title        String   
  description  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("program_specific_outcomes")
}

model CourseOutcome {
  id          String         @id @default(uuid())
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  code        String         // e.g. "CO1", "CO2"
  description String
  bloomLevel  String         // Remember, Understand, Apply, Analyze, Evaluate, Create
  mappings    CoPoMapping[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("course_outcomes")
}

model CoPoMapping {
  id               String        @id @default(uuid())
  coId             String
  co               CourseOutcome @relation(fields: [coId], references: [id], onDelete: Cascade)
  targetCode       String        // e.g. "PO1", "PSO1"
  targetType       String        // PO, PSO
  correlationLevel Int           @default(3) // 1 = Low, 2 = Medium, 3 = High
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("co_po_mappings")
}

model CurriculumUnit {
  id          String            @id @default(uuid())
  subjectId   String
  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitNumber  String            // e.g. "Unit I", "Unit II"
  name        String            // e.g. "Algorithm Analysis & Growth of Functions"
  description String?
  totalHours  Int               @default(9)
  topics      CurriculumTopic[]
  materials   CurriculumMaterial[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("curriculum_units")
}

model CurriculumTopic {
  id              String            @id @default(uuid())
  unitId          String
  unit            CurriculumUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topicNumber     String?           // e.g. "1.1"
  title           String            
  subTopics       String?           // JSON array or text
  learningOutcomes String?
  materials       CurriculumMaterial[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("curriculum_topics")
}

model CurriculumMaterial {
  id          String           @id @default(uuid())
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        CurriculumUnit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topicId     String?
  topic       CurriculumTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title       String
  type        String           // NOTES, PDF, PPT, WORD, EXCEL, VIDEO, IMAGE, ZIP, SOURCE_CODE, REFERENCE_BOOK, LAB_MANUAL, TUTORIAL, YOUTUBE
  url         String
  fileSize    Int?
  authorName  String?
  status      String           @default("PUBLISHED")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("curriculum_materials")
}

model QuestionBankItem {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId      String?
  category    String   // MARKS_2, MARKS_5, MARKS_10, MARKS_13, MARKS_15, MARKS_16, MCQ, PROGRAMMING, NUMERICAL, LAB_VIVA, PREVIOUS_YEAR, IMPORTANT
  question    String
  options     String?  // JSON string for MCQ options if applicable
  answer      String?
  bloomLevel  String?  // Remember, Understand, Apply, etc.
  difficulty  String   @default("MEDIUM") // EASY, MEDIUM, HARD
  year        String?  // e.g. "2024"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("question_bank_items")
}

model LabExperiment {
  id            String   @id @default(uuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  expNumber     Int
  title         String
  objective     String?
  equipment     String?
  procedure     String?
  vivaQuestions String?  // JSON text of questions & answers
  manualUrl     String?
  simulationUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("lab_experiments")
}

model CurriculumVersionLog {
  id            String   @id @default(uuid())
  regulationId  String
  versionNumber Int
  changeSummary String
  snapshotData  String   // JSON string of full regulation curriculum structure
  createdById   String
  createdAt     DateTime @default(now())

  @@map("curriculum_version_logs")
}

model MasterRecord {
  id        String   @id @default(uuid())
  type      String // e.g. "BLOOD_GROUP", "RELIGION", "TRANSPORT_STOP", "HOSTEL_BLOCK", "ROOM"
  value     String
  extra     String? // JSON string for extra info e.g. { block: "A", capacity: 4 } for ROOM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@map("master_records")
}

model UserActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String // CREATE, UPDATE, DELETE, UPLOAD
  module      String // e.g. "USER", "ROLE", "ACADEMIC", "SETTING"
  description String
  ipAddress   String?
  userAgent   String?
  browser     String?
  device      String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("user_activity_logs")
}

model BackupLog {
  id          String   @id @default(uuid())
  filePath    String
  fileName    String
  backupType  String // MANUAL, AUTOMATIC
  fileSize    Int // in bytes
  triggeredBy String // user email or SYSTEM
  status      String // SUCCESS, FAILED
  createdAt   DateTime @default(now())

  @@map("backup_logs")
}

model MediaFile {
  id        String   @id @default(uuid())
  name      String
  path      String   @unique
  mimeType  String
  fileSize  Int
  folder    String   @default("/") // Folder organization path e.g. "/images", "/documents"
  createdAt DateTime @default(now())
