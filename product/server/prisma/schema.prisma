  @@map("advisor_sessions")
}

// ==========================================
// CENTRALIZED MASTER TIMETABLE ENGINE (COE & DEAN ACADEMICS CONTROL)
// ==========================================

model MasterTimetable {
  id            String               @id @default(uuid())
  academicYear  String
  semester      String
  departmentId  String
  programId     String
  section       String               // e.g. "A", "B"
  status        String               @default("DRAFT") // DRAFT, PUBLISHED, LOCKED, ARCHIVED
  version       Int                  @default(1)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?                @relation("TimetablePublisher", fields: [publishedById], references: [id])
  slots         MasterTimetableSlot[]
  versions      TimetableVersion[]
  auditLogs     TimetableAuditLog[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([academicYear, semester, departmentId, programId, section, version])
  @@map("master_timetables")
}

model MasterTimetableSlot {
  id                String          @id @default(uuid())
  masterTimetableId String
  masterTimetable   MasterTimetable @relation(fields: [masterTimetableId], references: [id], onDelete: Cascade)
  dayOfWeek         String          // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
  periodNumber      Int             // 1 to 8
  startTime         String          // e.g. "08:30"
  endTime           String          // e.g. "09:20"
  subjectId         String
  facultyId         String
  roomNo            String?
  building          String?
  isLab             Boolean         @default(false)
  labName           String?

  @@index([facultyId, dayOfWeek, periodNumber])
  @@index([roomNo, dayOfWeek, periodNumber])
  @@map("master_timetable_slots")
}

model TimetableVersion {
  id                String          @id @default(uuid())
  masterTimetableId String
  masterTimetable   MasterTimetable @relation(fields: [masterTimetableId], references: [id], onDelete: Cascade)
  versionNumber     Int
  snapshotData      String          // Full JSON string snapshot of slots & allocations
  changeReason      String?
  createdById       String
  createdAt         DateTime        @default(now())

  @@map("timetable_versions")
}

model TimetableAuditLog {
  id                String          @id @default(uuid())
  masterTimetableId String
  masterTimetable   MasterTimetable @relation(fields: [masterTimetableId], references: [id], onDelete: Cascade)
  action            String          // CREATE, UPDATE, CONFLICT_CHECK, PUBLISH, LOCK, RESTORE, DELETE
  performedById     String
  performedByRole   String
  ipAddress         String?
  userAgent         String?
  oldValue          String?         // JSON string
  newValue          String?         // JSON string
  reason            String?
  createdAt         DateTime        @default(now())

  @@map("timetable_audit_logs")
}

