model SecurityVerification {
  id           String   @id @default(uuid())
  verifierId   String
  targetId     String
  targetType   String   // STUDENT, FACULTY, STAFF, VISITOR, VEHICLE
  method       String   @default("QR") // QR, MANUAL, BIOMETRIC
  result       String   // VERIFIED, FAILED, EXPIRED, INVALID
  qrPayload    String?
  responseData String?  // JSON — minimum required info returned
  ipAddress    String?
  deviceId     String?
  timestamp    DateTime @default(now())

  @@index([targetId, targetType])
  @@index([verifierId])
  @@index([timestamp])
  @@map("security_verifications")
}

