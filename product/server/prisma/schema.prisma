// MODULE 34: PURCHASE & PROCUREMENT
// ==========================================

model PurchaseRequest {
  id              String   @id @default(uuid())
  requestNumber   String   @unique
  departmentId    String
  requestedById   String
  title           String
  description     String
  category        String   @default("GENERAL") // GENERAL, IT, LAB, FURNITURE, STATIONERY, OTHER
  items           String   @default("[]") // JSON: [{name, qty, estPrice, specs}]
  estimatedAmount Float
  budgetHead      String?
  priority        String   @default("MEDIUM")
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, HOD_APPROVED, FINANCE_APPROVED, PRINCIPAL_APPROVED, PO_CREATED, COMPLETED, REJECTED
  currentStep     String   @default("HOD")
  attachments     String   @default("[]") // JSON
  remarks         String?
  approvedAmount  Float?
