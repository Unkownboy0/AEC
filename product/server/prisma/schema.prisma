  // Personal Information
  gender          String?  @default("Male")
  bloodGroup      String?
  maritalStatus   String?
  nationality     String?
  aadhaarNo       String?
  panNo           String?
  personalEmail   String?
  personalPhone   String?
  alternatePhone  String?
  emergencyName   String?
  emergencyPhone  String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  district        String?
  state           String?
  country         String?
  pincode         String?

  // Professional Information
  program         String?  @default("B.Tech")
  employmentType  String?  @default("FULL_TIME")
  specialization  String?
  highestDegree   String?
  university      String?
  researchArea    String?
  facultyType     String?  @default("REGULAR")
  officeRoom      String?
  officeExtension String?

  // Academic & Research Information
  highestQualification     String?
  additionalCertifications String? @default("[]")
  researchInterests        String? @default("[]")
  publications             String? @default("[]")
  patents                  String? @default("[]")
  books                    String? @default("[]")
  industryExperience       Int?    @default(0)
  professionalMemberships  String? @default("[]")
  linkedinProfile          String?
  googleScholar            String?
  orcidId                  String?
  portfolioWebsite         String?

  // Preferences
  notificationPrefs        String? @default("{\"email\":true,\"sms\":true,\"push\":true,\"assignmentAlerts\":true,\"attendanceAlerts\":true,\"leaveAlerts\":true,\"meetingAlerts\":true}")

  attendanceRecords  Attendance[]
  exams              Exam[]
  tickets            Ticket[]
  counselingGiven    CounselingRecord[]
  timetableSlots     TimetableSlot[]
  subjectAssignments SubjectAssignment[]
  assignments        Assignment[]
  assignedSubjects   Subject[]
  mentoredStudents   Student[]           @relation("StudentMentor")
  mentorAssignments  MentorAssignment[]  @relation("MentorAssignmentMentor")
  chatMessages      ChatMessage[]
  workflowRequestsAsRequester WorkflowRequest[] @relation("FacultyRequester")

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

