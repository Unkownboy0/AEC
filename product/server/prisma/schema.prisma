model WorkflowRequest {
  id                 String            @id @default(uuid())
  studentId          String?
  student            Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type               String // LEAVE, OD, BONAFIDE, TC, CONDUCT_CERTIFICATE, HOSTEL_LEAVE, BUS_PASS, SCHOLARSHIP, INTERNSHIP_PERMISSION, IV_PERMISSION, MEDICAL_LEAVE, FACULTY_LEAVE, FACULTY_OD
  title              String
