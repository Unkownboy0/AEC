model Attendance {
  id      String   @id @default(uuid())
  date    DateTime
  status  String // PRESENT, ABSENT, LATE
  type    String   @default("DAILY") // DAILY, PERIOD
  remarks String?

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([date])
  @@index([studentId])
  @@index([facultyId])
  @@map("attendance")
}

model Exam {
  id             String   @id @default(uuid())
  name           String
  type           String   @default("INTERNAL") // INTERNAL, EXTERNAL
  startDate      DateTime
  endDate        DateTime
  status         String   @default("DRAFT") // DRAFT, SCHEDULED, COMPLETED
  schedule       String   @default("[]") // JSON string exam dates/subjects
  hallAllocation String   @default("[]") // JSON list of rooms & seating
  invigilators   String   @default("[]") // JSON details

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id])
  semesterId     String
  semester       Semester     @relation(fields: [semesterId], references: [id])
  facultyId      String?
  coordinator    Faculty?     @relation(fields: [facultyId], references: [id])

  marks Mark[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([academicYearId])
  @@index([courseId])
  @@index([semesterId])
  @@map("exams")
}

model Mark {
  id             String @id @default(uuid())
  internalMarks  Int    @default(0)
  externalMarks  Int    @default(0)
  practicalMarks Int    @default(0)
  grade          String @default("F")
  gpa            Float  @default(0.0)
  cgpa           Float  @default(0.0)
  status         String @default("DRAFT") // DRAFT, PUBLISHED

  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([examId, studentId, subjectId])
  @@index([studentId])
  @@index([subjectId])
  @@map("marks")
}

model FeeCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  amount      Float
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE
  bills       FeeBill[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("fee_categories")
}

model FeeBill {
  id                  String   @id @default(uuid())
  amount              Float
  scholarshipDiscount Float    @default(0.0)
  fine                Float    @default(0.0)
  paidAmount          Float    @default(0.0)
  status              String   @default("PENDING") // PENDING, PAID, PARTIAL
  billingDate         DateTime
  dueDate             DateTime
  paymentHistory      String   @default("[]") // JSON payments list
  receipts            String   @default("[]") // JSON receipts list

  studentId  String
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  categoryId String
  category   FeeCategory @relation(fields: [categoryId], references: [id])

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([studentId])
  @@index([categoryId])
  @@map("fee_bills")
}

model LibraryBook {
  id              String  @id @default(uuid())
  title           String
  isbn            String  @unique
  category        String
  author          String
  publisher       String
  totalCopies     Int     @default(1)
  availableCopies Int     @default(1)
  location        String?
  issues          String  @default("[]") // JSON list of issuances

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isbn])
  @@map("library_books")
}

model TransportRoute {
  id          String    @id @default(uuid())
  routeName   String    @unique
  vehicleNo   String
  driverName  String
  driverPhone String
  stops       String    @default("[]") // JSON list of stops/fees
  monthlyFee  Float     @default(0.0)
  students    Student[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("transport_routes")
}

model HostelBuilding {
  id          String    @id @default(uuid())
  name        String    @unique
  type        String    @default("BOYS") // BOYS, GIRLS
  description String?
  rooms       String    @default("[]") // JSON rooms, beds capacities
  students    Student[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("hostel_buildings")
}

model Ticket {
  id          String @id @default(uuid())
  title       String
  description String
  status      String @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  priority    String @default("MEDIUM") // LOW, MEDIUM, HIGH
  category    String @default("GENERAL") // IT, ACADEMIC, FEE, HOSTEL
  replies     String @default("[]") // JSON list replies

  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("tickets")
}

model WorkflowRequest {
  id           String            @id @default(uuid())
  studentId    String?
  student      Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         String // LEAVE, OD, BONAFIDE, TC, CONDUCT_CERTIFICATE, HOSTEL_LEAVE, BUS_PASS, SCHOLARSHIP, INTERNSHIP_PERMISSION, IV_PERMISSION, MEDICAL_LEAVE, FACULTY_LEAVE, FACULTY_OD
  title        String
  reason       String
  startDate    DateTime?
  endDate      DateTime?
  status       String            @default("PENDING_MENTOR") // PENDING_MENTOR, PENDING_HOD, PENDING_DEAN, PENDING_PRINCIPAL, APPROVED, REJECTED, CLARIFICATION_REQUESTED, HOD_APPROVED
  currentStep  String            @default("MENTOR") // MENTOR, HOD, DEAN, PRINCIPAL
  attachments  String            @default("[]") // JSON string of urls
  mentorId       String?           @map("mentor_id")
  facultyId      String?           @map("faculty_id")
  classAdvisorId String?           @map("class_advisor_id")
  departmentId   String?           @map("department_id")
  facultyRequesterId String?       @map("faculty_requester_id")
  facultyRequester   Faculty?      @relation("FacultyRequester", fields: [facultyRequesterId], references: [id], onDelete: SetNull)
  history      WorkflowHistory[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("workflow_requests")
}

model WorkflowHistory {
  id           String          @id @default(uuid())
  requestId    String
  request      WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stage        String // MENTOR, HOD, DEAN, PRINCIPAL
  action       String // SUBMIT, APPROVE, REJECT, CLARIFICATION, FORWARD
  comment      String?
  actionById   String
  actionByName String
  createdAt    DateTime        @default(now())

  @@map("workflow_history")
}

model TimetableSlot {
  id        String @id @default(uuid())
  dayOfWeek String // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
  slotIndex Int // 1, 2, 3, 4, 5, 6, 7, 8
  startTime String // e.g. "09:00"
  endTime   String // e.g. "09:50"

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesterId     String
  semester       Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId      String
  faculty        Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  roomNo    String
  isLab     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("timetable_slots")
}

model CounselingRecord {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId    String
  mentor      Faculty  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  notes       String
  actionTaken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("counseling_records")
}

model PlacementRecord {
  id          String   @id @default(uuid())
  studentRoll String
  company     String
  package     Float // LPA e.g. 8.5
  role        String
  status      String // ELIGIBLE, APPLIED, SELECTED, REJECTED
  driveDate   DateTime
  createdAt   DateTime @default(now())

  @@map("placement_records")
}

// ==========================================
// ENTERPRISE RBAC - DYNAMIC MENU ITEMS
// ==========================================

model MenuItem {
  id                 String   @id @default(uuid())
  name               String
  path               String
  icon               String   @default("Layers")
  componentKey       String
  permissionRequired String?
  parentPath         String? // For sub-menu grouping
  group              String? // e.g. "ACADEMIC", "ADMIN", "STUDENT"
  order              Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("menu_items")
}

// ==========================================
// ENTERPRISE RBAC - FACULTY SUBJECT ASSIGNMENTS
// ==========================================

model SubjectAssignment {
  id             String       @id @default(uuid())
  facultyId      String
  faculty        Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  semesterId     String
  semester       Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  isMentor       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([facultyId, subjectId, sectionId, semesterId])
  @@index([facultyId])
  @@index([subjectId])
  @@index([sectionId])
  @@map("subject_assignments")
}

// ==========================================
// ENTERPRISE RBAC - SECURITY AUDIT LOGS
// ==========================================

model SecurityAuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  userRole    String?
  action      String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, APPROVE, REJECT, DENIED, EXPORT, RESET_PASSWORD, ROLE_CHANGE
  module      String // e.g. STUDENT, FACULTY, ATTENDANCE, MARKS, FEES, WORKFLOW
  targetId    String? // e.g. student ID being accessed
  targetType  String? // e.g. Student, Faculty, FeeBill
  description String
  statusCode  Int? // HTTP status code (200 / 403 / 404)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("security_audit_logs")
}

// ==========================================
// AI ACADEMIC ADVISER
// ==========================================

model AiMessage {
  id        String   @id @default(uuid())
  role      String // "user" or "assistant"
  content   String
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId String? // optional grouping for conversation sessions
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([sessionId])
  @@map("ai_messages")
}

// ==========================================
// ASSIGNMENT MODULE
// ==========================================

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  maxMarks    Int      @default(100)
  status      String   @default("ACTIVE") // ACTIVE, CLOSED, DRAFT

  facultyId      String
  faculty        Faculty       @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId      String?
  section        Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  semesterId     String?
  semester       Semester?     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  programId      String?
  program        Program?      @relation(fields: [programId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  targetSubject  String?
  targetClass    String?

  attachments String                 @default("[]") // JSON array of file paths
  submissions AssignmentSubmission[]

  archived  Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facultyId])
  @@index([subjectId])
  @@index([sectionId])
  @@index([semesterId])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String   @id @default(uuid())
  status        String   @default("SUBMITTED") // SUBMITTED, GRADED, LATE, MISSING
  marksObtained Int?
  feedback      String?
  submittedAt   DateTime @default(now())
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  fileType      String?
  facultyId     String?
  departmentId  String?
  semesterId    String?
  sectionId     String?

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model MentorAssignment {
  id             String       @id @default(uuid())
  mentorId       String
  mentor         Faculty      @relation("MentorAssignmentMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation("MentorAssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id])
  programId      String
  program        Program      @relation(fields: [programId], references: [id])
  semesterId     String
  semester       Semester     @relation(fields: [semesterId], references: [id])
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  assignedBy     String
  status         String       @default("ACTIVE") // ACTIVE, HISTORIC
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("mentor_assignments")
}

model Internship {
  id        String               @id @default(uuid())
  company   String
  role      String?
  duration  String
  credits   Int                  @default(2)
  status    String               @default("PENDING") // PENDING, APPROVED, REJECTED
  studentId String
  student   Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents InternshipDocument[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([studentId])
  @@map("internships")
}

model InternshipDocument {
  id                 String     @id @default(uuid())
  documentType       String     // Offer Letter, Completion Certificate, etc.
  fileName           String
  fileUrl            String
  fileSize           Int
  fileType           String
  uploadedBy         String     // e.g. student's name
  uploadedAt         DateTime   @default(now())
  verificationStatus String     @default("PENDING") // PENDING, VERIFIED, REJECTED

  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([internshipId])
  @@index([studentId])
  @@map("internship_documents")
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String
  facultyId      String
  faculty        Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  senderRole     String    // "Faculty" or "Student"
  receiverRole   String    // "Student" or "Faculty"
  subject        String?
  message        String
  attachmentUrl  String?
  attachmentType String?
  priority       String    @default("NORMAL") // NORMAL, HIGH, URGENT

  status         String    @default("SENT") // SENT, DELIVERED, READ
  sentTime       DateTime  @default(now())
  deliveredTime  DateTime?
  readTime       DateTime?

  deletedByFaculty Boolean @default(false)
  deletedByStudent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([facultyId])
  @@index([studentId])
  @@map("chat_messages")
}

model HodCircular {
  id             String                   @id @default(uuid())
  title          String
  category       String
  priority       String                   @default("NORMAL")
  description    String?
  content        String
  status         String                   @default("DRAFT")
  images         String                   @default("[]")
  attachmentUrl  String?
  attachmentName String?
  publishedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  departmentId   String
  department     Department               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  publishedById  String
  publishedBy    User                     @relation("CircularCreator", fields: [publishedById], references: [id])

  recipients     HodCircularReadTracker[]

  @@index([departmentId])
  @@index([publishedById])
  @@map("hod_circulars")
}

model HodCircularReadTracker {
  id             String       @id @default(uuid())
  circularId     String
  circular       HodCircular  @relation(fields: [circularId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserCircularReadTracker", fields: [userId], references: [id], onDelete: Cascade)
  
  status         String       @default("DELIVERED")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([circularId, userId])
  @@index([circularId])
  @@index([userId])
  @@map("hod_circular_read_trackers")
}

model PlacementDrive {
