model Task {
  id                String              @id @default(uuid())
  taskNumber        String              @unique
  title             String
  description       String?
  category          String              @default("ACADEMIC_DOCUMENTATION") // NBA, NAAC, IQAC, ACADEMIC_AUDIT, RESULT_VERIFICATION, RESEARCH, PLACEMENT, etc.
  priority          String              @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  startDate         DateTime?
  endDate           DateTime?
  dueDate           DateTime?
  departmentId      String?
  department        Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User                @relation("TaskCreator", fields: [createdById], references: [id])
  status            String              @default("NOT_SEEN") // NOT_SEEN, SEEN, ACCEPTED, IN_PROGRESS, WAITING_APPROVAL, COMPLETED, REJECTED, OVERDUE
  visibility        String              @default("ASSIGNED") // ASSIGNED, DEPARTMENT, PUBLIC
  completionPercent Int                 @default(0)
  checklist         String? // JSON array of checklist items [{id, title, isCompleted}]
  estimatedHours    Float?
  colorLabel        String? // Hex code or badge color name
  slaHours          Int? // SLA duration in hours
  isRecurring       Boolean             @default(false)
  recurringRule     String? // JSON { frequency: 'DAILY'|'WEEKLY'|'MONTHLY'|'SEMESTER' }
  templateId        String?
  parentTaskId      String?
  parentTask        Task?               @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks          Task[]              @relation("SubTasks")
  relatedEntityType String? // CIRCULAR, STUDENT, LEAVE, EXAM, GOVERNANCE_DOC
  relatedEntityId   String?
  remarks           String?
  completedAt       DateTime?
  assignees         TaskAssignee[]
  history           TaskStatusHistory[]
  comments          TaskComment[]
  attachments       Attachment[]
  predecessors      TaskDependency[]    @relation("SuccessorTask")
  successors        TaskDependency[]    @relation("PredecessorTask")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([createdById])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([dueDate])
  @@map("tasks")
}

model TaskDependency {
