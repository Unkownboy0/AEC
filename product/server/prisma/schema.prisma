  departmentId     String?
  type             String // LEAVE, ON_DUTY
  requestCategory  String?  @default("PERSONAL") // MEDICAL, PERSONAL, EMERGENCY, PERMISSION, HALF_DAY, INTERNSHIP, PLACEMENT, SPORTS, CULTURAL, WORKSHOP, INDUSTRIAL_VISIT, COMPETITION, OTHER
  reason           String
  description      String?
  startDate        DateTime
  endDate          DateTime
  startTime        String?
  endTime          String?
  durationType     String?  @default("FULL_DAY") // FULL_DAY, HALF_DAY
  totalDays        Int      @default(1)
  eventName        String?
  eventLocation    String?
  emergencyContact String?
  attachmentUrl    String?

  status                String  @default("PENDING_MENTOR") // DRAFT, PENDING_MENTOR, RETURNED_TO_STUDENT, REJECTED_BY_MENTOR, PENDING_HOD, RETURNED_TO_MENTOR, REJECTED_BY_HOD, PENDING_DEAN, APPROVED, CANCELLED, EXPIRED
  studentStatus         String? @default("SUBMITTED")
  mentorStatus          String? @default("PENDING")
  hodStatus             String? @default("PENDING")
  finalStatus           String? @default("PENDING")
  workflowStatus        String? @default("PENDING_MENTOR")
  priority              String? @default("NORMAL")
  isEmergency           Boolean @default(false)
  studentActionRequired Boolean @default(false)

  mentorId         String?
  mentor           Faculty?  @relation("MentorLeaveReview", fields: [mentorId], references: [id], onDelete: SetNull)
  mentorApprovedAt DateTime?
  mentorRemarks    String?

  hodId         String?
  hodApprovedAt DateTime?
  hodRemarks    String?

  forwardedToHodAt DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?

  attendanceUpdated Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  approvals       RequestApproval[]
  workflowHistory RequestWorkflowHistory[]
  attachments     RequestAttachment[]

  @@index([studentId])
  @@index([mentorId])
  @@index([hodId])
  @@index([departmentId])
  @@index([status])
  @@index([workflowStatus])
  @@index([startDate, endDate])
  @@map("student_leave_requests")
}

