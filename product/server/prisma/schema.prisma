  verifiedAt         DateTime?
  consentToConnect   Boolean   @default(false)
  consentToMentor    Boolean   @default(false)
  communicationPrefs String    @default("{}") // JSON
  employment         AlumniEmployment[]
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([departmentId])
  @@index([batch])
  @@index([yearOfGraduation])
  @@map("alumni_profiles")
}

model AlumniEmployment {
  id              String        @id @default(uuid())
  alumniId        String
  alumni          AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  organization    String
  designation     String
  location        String?
  type            String        @default("EMPLOYMENT") // EMPLOYMENT, HIGHER_STUDIES, ENTREPRENEURSHIP, OTHER
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean       @default(false)
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([alumniId])
  @@map("alumni_employment")
}

// ==========================================
// MODULE 45: UNIFIED CAMPUS CALENDAR
// ==========================================

model CalendarEvent {
  id            String    @id @default(uuid())
  title         String
  description   String?
  eventType     String    // ACADEMIC, HOLIDAY, EXAM, MEETING, TASK, PLACEMENT, EVENT, SPORTS, LEAVE, PERSONAL
  sourceModule  String?   // The module that created this event
  sourceId      String?   // ID in the source module
  startDate     DateTime
  endDate       DateTime?
  allDay        Boolean   @default(false)
  startTime     String?
  endTime       String?
  venue         String?
  onlineLink    String?
  scope         String    @default("INSTITUTION") // INSTITUTION, DEPARTMENT, PROGRAM, SECTION, PERSONAL
  departmentId  String?
  createdById   String
  visibility    String    @default("PUBLIC") // PUBLIC, RESTRICTED, PRIVATE
  targetAudience String  @default("[]") // JSON: roles, departments, etc.
  color         String?
  isRecurring   Boolean   @default(false)
  recurrenceRule String?  // iCal RRULE format
  reminderMinutes Int?
  status        String    @default("ACTIVE") // ACTIVE, CANCELLED, POSTPONED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([startDate, endDate])
  @@index([eventType])
  @@index([scope, departmentId])
  @@index([sourceModule, sourceId])
  @@map("calendar_events")
}

// ==========================================
// MODULE 46: EMERGENCY & SOS
// ==========================================

model EmergencyAlert {
  id              String    @id @default(uuid())
  alertNumber     String    @unique
  type            String    // SECURITY, MEDICAL, TRANSPORT, CAMPUS_CLOSURE, FIRE, NATURAL_DISASTER, OTHER
  severity        String    @default("HIGH") // MEDIUM, HIGH, CRITICAL
  title           String
  message         String
  instructions    String?
  scope           String    @default("CAMPUS_WIDE") // CAMPUS_WIDE, BUILDING, DEPARTMENT, HOSTEL, TRANSPORT
  scopeDetails    String?   // JSON: specific buildings, departments, etc.
  initiatedById   String
  initiatedByRole String
  status          String    @default("ACTIVE") // ACTIVE, UPDATED, RESOLVED, FALSE_ALARM
  resolvedAt      DateTime?
  resolvedById    String?
  resolution      String?
  updateHistory   String    @default("[]") // JSON: [{time, update, by}]
  channels        String    @default("[\"IN_APP\",\"PUSH\"]") // JSON: delivery channels
  acknowledgements EmergencyAcknowledgement[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("emergency_alerts")
}

model EmergencyAcknowledgement {
  id            String         @id @default(uuid())
  alertId       String
  alert         EmergencyAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId        String
  status        String         @default("RECEIVED") // RECEIVED, ACKNOWLEDGED, SAFE, NEED_HELP
  message       String?
  location      String?
  acknowledgedAt DateTime      @default(now())

  @@unique([alertId, userId])
  @@index([alertId])
  @@map("emergency_acknowledgements")
}

// ==========================================
// MODULE 51: ACTIVITY ENGINE & STUDENT SKILLS
// ==========================================

model CampusActivity {
  id                  String   @id @default(uuid())
  title               String
  description         String?
  category            String   // ACADEMIC, TECHNICAL, TRAINING, PLACEMENT, RESEARCH, WORKSHOP, SEMINAR, CONFERENCE, HACKATHON, COMPETITION, CLUB, SPORTS, CULTURAL, NSS_NCC, ORIENTATION, INDUSTRIAL_VISIT, GUEST_LECTURE, CERTIFICATION, MEETING, INSTITUTIONAL_EVENT
  subcategory         String?
  organizerId         String
  responsibleStaffId  String?
  departmentId        String?
  programId           String?
  targetYear          Int?
  targetSection       String?
  audience            String   @default("[]") // JSON: eligible departments/programs/years/sections
  startDate           DateTime
  endDate             DateTime
  startTime           String?
  endTime             String?
  venue               String?
  onlineLink          String?
  capacity            Int?
  registrationRequired Boolean @default(false)
  attendanceRequired  Boolean  @default(true)
  assessmentRequired  Boolean  @default(false)
  certificateAvailable Boolean @default(false)
  evidenceRequired    Boolean  @default(false)
  approvalRequired    Boolean  @default(false)
  budget              Float?
  budgetApproved      Boolean  @default(false)
  status              String   @default("PLANNED") // PLANNED, APPROVED, REGISTRATION_OPEN, ONGOING, COMPLETED, CANCELLED
  sessions            ActivitySession[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([category, status])
  @@index([departmentId])
  @@index([startDate])
  @@map("campus_activities")
}

model ActivitySession {
  id            String         @id @default(uuid())
  activityId    String
  activity      CampusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title         String?
  date          DateTime       @db.Date
  startTime     String
  endTime       String
  venue         String?
  trainerId     String?
  trainerName   String?
  topic         String?
  sessionOrder  Int            @default(1)
  status        String         @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  attendance    ActivityAttendanceRecord[]
  assessments   ActivityAssessment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([activityId, date])
  @@map("activity_sessions")
}

model ActivityAttendanceRecord {
  id          String          @id @default(uuid())
  sessionId   String
  session     ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId   String
  date        DateTime        @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      String          @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED, OD
  source      String          @default("MANUAL") // MANUAL, QR, SELF_CHECK_IN, IMPORT
  recordedById String?
  correctionHistory String    @default("[]") // JSON
  createdAt   DateTime        @default(now())

  @@unique([sessionId, studentId, date])
  @@index([studentId, date])
  @@map("activity_attendance")
}

model ActivityAssessment {
  id            String          @id @default(uuid())
  sessionId     String?
  session       ActivitySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  activityId    String
  studentId     String
  type          String          @default("COMPLETION") // QUIZ, TEST, PRACTICAL, ASSIGNMENT, PRESENTATION, EVALUATION, PARTICIPATION, COMPLETION
  maxScore      Float?
  score         Float?
  grade         String?
  feedback      String?
  evaluatedById String?
  evaluatedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([studentId, activityId])
  @@map("activity_assessments")
}

model StudentSkill {
  id           String   @id @default(uuid())
  studentId    String
  skillName    String
  category     String   @default("TECHNICAL") // TECHNICAL, SOFT, DOMAIN, LANGUAGE, TOOL
  source       String   // COURSE, TRAINING, PROJECT, CERTIFICATION, HACKATHON, FACULTY_VERIFIED
  sourceId     String?  // Reference to the source (activity ID, course ID, etc.)
  evidenceId   String?  // Link to Evidence Repository
  level        String?  // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  verifiedById String?
  verifiedAt   DateTime?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, skillName, source])
  @@index([studentId])
  @@index([skillName])
  @@map("student_skills")
}

// ==========================================
// WORKFLOW ENGINE ENHANCEMENTS (M28)
// ==========================================

model WorkflowDefinition {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  module       String   // LEAVE, OD, CERTIFICATE, PURCHASE, REFUND, APPRAISAL, GRIEVANCE, GATE_PASS
  description  String?
  steps        String   @default("[]") // JSON: [{step, assigneeType, assigneeResolution, actions, sla}]
  conditions   String   @default("{}") // JSON: conditional routing
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  configuredById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([code, version])
  @@index([module, isActive])
  @@map("workflow_definitions")
}
