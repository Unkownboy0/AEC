  hallAllocation String   @default("[]") // JSON list of rooms & seating
  invigilators   String   @default("[]") // JSON details

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id])
  semesterId     String
  semester       Semester     @relation(fields: [semesterId], references: [id])
  facultyId      String?
  coordinator    Faculty?     @relation(fields: [facultyId], references: [id])

  marks Mark[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([academicYearId])
  @@index([courseId])
  @@index([semesterId])
  @@map("exams")
}

model Mark {
  id             String @id @default(uuid())
  internalMarks  Int    @default(0)
  externalMarks  Int    @default(0)
  practicalMarks Int    @default(0)
  grade          String @default("F")
  gpa            Float  @default(0.0)
  cgpa           Float  @default(0.0)
