  driverName  String
  driverPhone String
  stops       String    @default("[]") // JSON list of stops/fees
  monthlyFee  Float     @default(0.0)
  students    Student[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

