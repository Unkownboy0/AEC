// ==========================================
// ACADEMIC DEAN TASK WORKSPACE & ADMISSION COORDINATION MODELS
// ==========================================

model AcademicTask {
  id                     String    @id @default(uuid())
  taskCode               String    @unique
  title                  String
  description            String?
  category               String    @default("ACADEMIC_REPORT")
  expectedOutput         String?
  instructions           String?
  priority               String    @default("MEDIUM")
  confidentialityLevel   String    @default("INTERNAL")
  assignmentMode         String    @default("SINGLE_DEPARTMENT")
  startAt                DateTime  @default(now())
  dueAt                  DateTime
  publishedAt            DateTime?
  scheduledPublishAt     DateTime?
  status                 String    @default("DRAFT")
  reminderConfig         String? // JSON string
  submissionRequirements String? // JSON string
  templateId             String?
  createdById            String
  createdBy              User      @relation("AcademicTaskCreator", fields: [createdById], references: [id])
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  assignments AcademicTaskAssignment[]
  files       AcademicTaskFile[]
  queries     AcademicTaskQuery[]
  timeline    AcademicTaskTimeline[]
  reminders   AcademicTaskReminder[]

  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([dueAt])
  @@map("academic_tasks")
}

model AcademicTaskAssignment {
  id                String       @id @default(uuid())
  taskId            String
  task              AcademicTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department   @relation("AcademicTaskDepartment", fields: [departmentId], references: [id], onDelete: Cascade)
  assignedHodUserId String
  assignedHod       User         @relation("AcademicTaskHod", fields: [assignedHodUserId], references: [id], onDelete: Cascade)
  assignmentCode    String       @unique
  status            String       @default("ASSIGNED")
  viewedAt          DateTime?
  startedAt         DateTime?
  submittedAt       DateTime?
  completedAt       DateTime?
  originalDueAt     DateTime
  currentDueAt      DateTime
  assignedById      String
  assignedBy        User         @relation("AcademicTaskAssigner", fields: [assignedById], references: [id])
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  files       AcademicTaskFile[]
  queries     AcademicTaskQuery[]
  submissions AcademicTaskSubmission[]
  timeline    AcademicTaskTimeline[]
  reminders   AcademicTaskReminder[]

  @@unique([taskId, departmentId])
  @@index([taskId])
  @@index([departmentId])
  @@index([assignedHodUserId])
  @@index([status])
  @@index([currentDueAt])
  @@map("academic_task_assignments")
}

model AcademicTaskFile {
  id               String                  @id @default(uuid())
  taskId           String
  task             AcademicTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId     String?
  assignment       AcademicTaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileScope        String                  @default("REFERENCE")
  fileCategory     String?
  fileName         String
  originalFileName String
  storageReference String
  mimeType         String
  fileSize         Int
  versionNumber    Int                     @default(1)
  uploadedById     String
  uploadedBy       User                    @relation("AcademicTaskFileUploader", fields: [uploadedById], references: [id])
  scanStatus       String                  @default("CLEAN")
  description      String?
  isActive         Boolean                 @default(true)
  supersededById   String?
  createdAt        DateTime                @default(now())

  @@index([taskId])
  @@index([assignmentId])
  @@index([fileScope])
  @@index([uploadedById])
  @@map("academic_task_files")
}

model AcademicTaskQuery {
  id            String                  @id @default(uuid())
  taskId        String
  task          AcademicTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId  String?
  assignment    AcademicTaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  parentQueryId String?
  parentQuery   AcademicTaskQuery?      @relation("QueryReplies", fields: [parentQueryId], references: [id], onDelete: Cascade)
  replies       AcademicTaskQuery[]     @relation("QueryReplies")
  message       String
  status        String                  @default("OPEN")
  visibility    String                  @default("ASSIGNMENT_PRIVATE")
