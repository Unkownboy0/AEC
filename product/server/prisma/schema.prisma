model Vehicle {
  id              String   @id @default(uuid())
  vehicleNumber   String   @unique
  type            String   @default("BUS") // BUS, MINI_BUS, VAN, CAR
  make            String?
  model           String?
  year            Int?
  capacity        Int
  fuelType        String   @default("DIESEL")
  status          String   @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?
  permitExpiry    DateTime?
  registrationNo  String?
  gpsDeviceId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routes            TransportRouteVehicle[]
  maintenanceRecords TransportMaintenance[]
  fuelRecords       TransportFuel[]
  breakdowns        TransportBreakdown[]

  @@map("vehicles")
}

model TransportStop {
  id           String   @id @default(uuid())
  routeId      String
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name         String
  landmark     String?
  latitude     Float?
  longitude    Float?
  sequence     Int
  pickupTime   String?
  dropTime     String?
  fee          Float    @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  allocations  TransportAllocation[]

  @@unique([routeId, sequence])
  @@map("transport_stops")
}

model TransportDriver {
  id            String   @id @default(uuid())
  name          String
  phone         String
  alternatePhone String?
  licenseNo     String   @unique
  licenseExpiry DateTime
  experience    Int      @default(0)
  address       String?
  photo         String?
  status        String   @default("ACTIVE")
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  routeAssignments TransportRouteVehicle[]

  @@map("transport_drivers")
}

model TransportRouteVehicle {
  id          String   @id @default(uuid())
  routeId     String
  route       TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      TransportDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  conductorId String?
  shift       String   @default("MORNING") // MORNING, EVENING, BOTH
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([routeId, vehicleId, shift])
  @@map("transport_route_vehicles")
}

model TransportAllocation {
  id            String   @id @default(uuid())
  routeId       String
  route         TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId        String
  stop          TransportStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  passengerId   String
  passengerType String   @default("STUDENT") // STUDENT, FACULTY, STAFF
  academicYear  String
  status        String   @default("ACTIVE") // ACTIVE, CANCELLED, SUSPENDED
  startDate     DateTime
  endDate       DateTime?
  monthlyFee    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([passengerId, passengerType])
  @@index([routeId, status])
  @@map("transport_allocations")
}

model TransportAttendance {
  id            String   @id @default(uuid())
  routeId       String
  vehicleId     String?
  passengerId   String
  passengerType String   @default("STUDENT")
  date          DateTime @db.Date
  direction     String   // PICKUP, DROP
  status        String   @default("BOARDED") // BOARDED, ABSENT, LATE
  boardingTime  DateTime?
  recordedBy    String?
  createdAt     DateTime @default(now())

  @@unique([routeId, passengerId, date, direction])
  @@index([passengerId, date])
  @@map("transport_attendance")
}

model TransportMaintenance {
  id            String    @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type          String    @default("ROUTINE") // ROUTINE, REPAIR, EMERGENCY
  description   String
  startDate     DateTime
  endDate       DateTime?
  cost          Float     @default(0)
  vendorId      String?
  status        String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([vehicleId, status])
  @@map("transport_maintenance")
}

model TransportFuel {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  quantity    Float
  costPerUnit Float
  totalCost   Float
  odometer    Int?
  filledById  String
  receiptUrl  String?
  createdAt   DateTime @default(now())

  @@index([vehicleId, date])
  @@map("transport_fuel")
}

model TransportBreakdown {
  id           String    @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  routeId      String?
  reportedAt   DateTime  @default(now())
  location     String?
  description  String
  severity     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status       String    @default("REPORTED") // REPORTED, RESCUE_SENT, RESOLVED
  resolvedAt   DateTime?
  resolution   String?
  reportedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vehicleId, status])
  @@map("transport_breakdowns")
}

