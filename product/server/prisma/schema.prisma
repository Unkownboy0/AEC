// MODULE 23: FACULTY / STAFF SELF APPRAISAL
// ==========================================

model AppraisalConfig {
  id             String   @id @default(uuid())
  academicYear   String
  title          String
  description    String?
  status         String   @default("DRAFT") // DRAFT, ACTIVE, CLOSED, ARCHIVED
  startDate      DateTime
  endDate        DateTime
  configuredById String
  categories     AppraisalCategory[]
  submissions    AppraisalSubmission[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([academicYear, title])
  @@map("appraisal_configs")
}

model AppraisalCategory {
  id            String   @id @default(uuid())
  configId      String
  config        AppraisalConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  name          String
  code          String
  description   String?
  maxPoints     Float    @default(100)
  weightage     Float    @default(1.0)
  sortOrder     Int      @default(0)
  subcategories AppraisalSubcategory[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([configId, code])
  @@map("appraisal_categories")
}

model AppraisalSubcategory {
  id                    String   @id @default(uuid())
  categoryId            String
  category              AppraisalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                  String
  code                  String
  description           String?
  maxPoints             Float    @default(10)
  pointsPerItem         Float    @default(1)
  maxItems              Int?
  evidenceRequired      Boolean  @default(true)
  verificationAuthority String   @default("HOD") // HOD, DEAN, IQAC, PRINCIPAL
  sortOrder             Int      @default(0)
  entries               AppraisalEntry[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([categoryId, code])
  @@map("appraisal_subcategories")
}

model AppraisalSubmission {
  id             String   @id @default(uuid())
  configId       String
  config         AppraisalConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  facultyId      String
  academicYear   String
  status         String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, RETURNED, VERIFIED, FINALIZED
  totalScore     Float    @default(0)
  weightedScore  Float    @default(0)
  submittedAt    DateTime?
  verifiedById   String?
  verifiedAt     DateTime?
  returnReason   String?
  finalizedAt    DateTime?
  entries        AppraisalEntry[]
  verifications  AppraisalVerification[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([configId, facultyId, academicYear])
  @@index([facultyId, academicYear])
  @@index([status])
  @@map("appraisal_submissions")
}

model AppraisalEntry {
  id              String   @id @default(uuid())
  submissionId    String
  submission      AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  subcategoryId   String
  subcategory     AppraisalSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  claimedPoints   Float    @default(0)
  verifiedPoints  Float?
  evidenceId      String?  // Link to Evidence Repository
  evidenceUrl     String?
  evidenceType    String?
  status          String   @default("CLAIMED") // CLAIMED, VERIFIED, REJECTED, RETURNED
  verifiedById    String?
  verifiedAt      DateTime?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([submissionId])
  @@index([subcategoryId])
  @@map("appraisal_entries")
}

model AppraisalVerification {
  id             String   @id @default(uuid())
  submissionId   String
  submission     AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  verifierId     String
  verifierRole   String
  action         String   // SUBMIT, VERIFY, RETURN, FINALIZE
  previousStatus String?
  newStatus      String
  remarks        String?
  createdAt      DateTime @default(now())

  @@index([submissionId])
  @@map("appraisal_verifications")
}

// ==========================================
// MODULE 24: EVIDENCE REPOSITORY
// ==========================================

model EvidenceItem {
  id             String   @id @default(uuid())
  ownerId        String
  ownerType      String   @default("FACULTY") // FACULTY, STUDENT, DEPARTMENT
  category       String   // CERTIFICATE, PUBLICATION, PATENT, RESEARCH, FDP, AWARD, EVENT, DOCUMENT, URL, DOI
  title          String
  description    String?
  fileKey        String?
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  fileHash       String?  // SHA-256 for dedup
  externalUrl    String?
  doi            String?
  metadata       String   @default("{}") // JSON: date, venue, organizer, etc.
  academicYear   String?
  verificationStatus String @default("UNVERIFIED") // UNVERIFIED, VERIFIED, REJECTED
  verifiedById   String?
  verifiedAt     DateTime?
  version        Int      @default(1)
  previousVersionId String?
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  links          EvidenceLink[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId, ownerType])
  @@index([category, academicYear])
  @@index([fileHash])
  @@map("evidence_items")
}

model EvidenceLink {
  id           String       @id @default(uuid())
  evidenceId   String
  evidence     EvidenceItem @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  linkedModule String       // APPRAISAL, IQAC, RESEARCH, PROFILE, ANNUAL_REPORT, DEPARTMENT_REPORT
  linkedId     String
  linkedType   String?
  createdAt    DateTime     @default(now())

  @@unique([evidenceId, linkedModule, linkedId])
  @@index([linkedModule, linkedId])
  @@map("evidence_links")
}

