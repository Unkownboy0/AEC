  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // ADMIN, MEMBER
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation("MessageSender", fields: [senderId], references: [id])
  type           String              @default("TEXT") // TEXT, IMAGE, DOCUMENT, AUDIO, SYSTEM
  content        String
  replyToId      String?
  isEdited       Boolean             @default(false)
  deletedAt      DateTime?
  attachments    MessageAttachment[]
  readReceipts   MessageReadReceipt[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@map("message_read_receipts")
}

model UserPresence {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String   @default("OFFLINE") // ONLINE, OFFLINE, AWAY, BUSY
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_presence")
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  actor          User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, ASSIGN, APPROVE, REJECT, SEED
  entityType     String   // USER, ROLE, PERMISSION, DEPARTMENT, TASK, COMMENT, FILE, NOTIFICATION, MESSAGE
  entityId       String?
  description    String
  previousValues String?  // JSON
  newValues      String?  // JSON
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// ACADEMIC DEAN TASK WORKSPACE & ADMISSION COORDINATION MODELS
// ==========================================

model AcademicTask {
  id                    String                   @id @default(uuid())
  taskCode              String                   @unique
  title                 String
  description           String?
  category              String                   @default("ACADEMIC_REPORT")
  expectedOutput        String?
  instructions          String?
  priority              String                   @default("MEDIUM")
  confidentialityLevel  String                   @default("INTERNAL")
  assignmentMode        String                   @default("SINGLE_DEPARTMENT")
  startAt               DateTime                 @default(now())
  dueAt                 DateTime
  publishedAt           DateTime?
  scheduledPublishAt    DateTime?
  status                String                   @default("DRAFT")
  reminderConfig        String?                  // JSON string
  submissionRequirements String?                 // JSON string
  templateId            String?
  createdById           String
  createdBy             User                     @relation("AcademicTaskCreator", fields: [createdById], references: [id])
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  assignments           AcademicTaskAssignment[]
  files                 AcademicTaskFile[]
  queries               AcademicTaskQuery[]
  timeline              AcademicTaskTimeline[]
  reminders             AcademicTaskReminder[]

  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([dueAt])
  @@map("academic_tasks")
}

model AcademicTaskAssignment {
  id                String                   @id @default(uuid())
  taskId            String
  task              AcademicTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department               @relation("AcademicTaskDepartment", fields: [departmentId], references: [id], onDelete: Cascade)
  assignedHodUserId String
  assignedHod       User                     @relation("AcademicTaskHod", fields: [assignedHodUserId], references: [id], onDelete: Cascade)
  assignmentCode    String                   @unique
  status            String                   @default("ASSIGNED")
  viewedAt          DateTime?
  startedAt         DateTime?
  submittedAt       DateTime?
  completedAt       DateTime?
  originalDueAt     DateTime
  currentDueAt      DateTime
  assignedById      String
  assignedBy        User                     @relation("AcademicTaskAssigner", fields: [assignedById], references: [id])
  version           Int                      @default(1)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  files             AcademicTaskFile[]
  queries           AcademicTaskQuery[]
  submissions       AcademicTaskSubmission[]
  timeline          AcademicTaskTimeline[]
  reminders         AcademicTaskReminder[]

  @@unique([taskId, departmentId])
  @@index([taskId])
  @@index([departmentId])
  @@index([assignedHodUserId])
  @@index([status])
  @@index([currentDueAt])
  @@map("academic_task_assignments")
}

model AcademicTaskFile {
  id               String                  @id @default(uuid())
  taskId           String
  task             AcademicTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId     String?
  assignment       AcademicTaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileScope        String                  @default("REFERENCE")
  fileCategory     String?
  fileName         String
  originalFileName String
  storageReference String
  mimeType         String
  fileSize         Int
  versionNumber    Int                     @default(1)
  uploadedById     String
  uploadedBy       User                    @relation("AcademicTaskFileUploader", fields: [uploadedById], references: [id])
  scanStatus       String                  @default("CLEAN")
  description      String?
  isActive         Boolean                 @default(true)
  supersededById   String?
  createdAt        DateTime                @default(now())

  @@index([taskId])
  @@index([assignmentId])
  @@index([fileScope])
  @@index([uploadedById])
  @@map("academic_task_files")
}

model AcademicTaskQuery {
  id            String                  @id @default(uuid())
  taskId        String
  task          AcademicTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId  String?
  assignment    AcademicTaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  parentQueryId String?
  parentQuery   AcademicTaskQuery?      @relation("QueryReplies", fields: [parentQueryId], references: [id], onDelete: Cascade)
  replies       AcademicTaskQuery[]     @relation("QueryReplies")
  message       String
  status        String                  @default("OPEN")
  visibility    String                  @default("ASSIGNMENT_PRIVATE")
  isPinned      Boolean                 @default(false)
  createdById   String
  createdBy     User                    @relation("AcademicTaskQueryAuthor", fields: [createdById], references: [id])
  resolvedById  String?
  resolvedBy    User?                   @relation("AcademicTaskQueryResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([taskId])
  @@index([assignmentId])
  @@index([status])
  @@index([createdById])
  @@map("academic_task_queries")
}

model AcademicTaskSubmission {
  id                String                 @id @default(uuid())
  assignmentId      String
  assignment        AcademicTaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionVersion Int                    @default(1)
  title             String
  notes             String?
  checklistData     String?                // JSON string
  status            String                 @default("SUBMITTED")
  submittedById     String
  submittedBy       User                   @relation("AcademicTaskSubmitter", fields: [submittedById], references: [id])
  submittedAt       DateTime               @default(now())
  reviewedById      String?
  reviewedBy        User?                  @relation("AcademicTaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewAction      String?
  reviewRemarks     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([assignmentId])
  @@index([status])
  @@index([submittedById])
  @@map("academic_task_submissions")
}

model AcademicTaskTimeline {
  id                String                  @id @default(uuid())
  taskId            String
  task              AcademicTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId      String?
  assignment        AcademicTaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  eventType         String
  actorUserId       String
  actor             User                    @relation("AcademicTaskTimelineActor", fields: [actorUserId], references: [id])
  actorRole         String
  departmentId      String?
  department        Department?             @relation("AcademicTaskTimelineDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  previousStatus    String?
  newStatus         String?
  remarks           String?
  relatedEntityType String?
  relatedEntityId   String?
  metadata          String?                 // JSON string
  createdAt         DateTime                @default(now())

  @@index([taskId])
  @@index([assignmentId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("academic_task_timeline")
}

model AcademicTaskReminder {
  id           String                  @id @default(uuid())
  taskId       String
  task         AcademicTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   AcademicTaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reminderType String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String                  @default("PENDING")
  retryCount   Int                     @default(0)
  createdAt    DateTime                @default(now())

  @@index([taskId])
  @@index([assignmentId])
  @@index([scheduledAt])
  @@index([status])
  @@map("academic_task_reminders")
}

model AcademicTaskTemplate {
  id                     String   @id @default(uuid())
  name                   String
  category               String   @default("ACADEMIC_REPORT")
  defaultTitle           String?
  defaultInstructions    String?
  submissionRequirements String?  // JSON string
  defaultChecklist       String?  // JSON string
  defaultFileRequirements String? // JSON string
  defaultPriority        String   @default("MEDIUM")
  reminderPattern        String?  // JSON string
  createdById            String
  createdBy              User     @relation("AcademicTaskTemplateCreator", fields: [createdById], references: [id])
  status                 String   @default("ACTIVE")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([createdById])
  @@index([category])
  @@map("academic_task_templates")
}

model AdmissionCoordinationRequest {
  id                 String     @id @default(uuid())
  requestCode        String     @unique
  title              String
  description        String
  requestType        String     @default("GENERAL_VERIFICATION")
  priority           String     @default("MEDIUM")
  departmentId       String
  department         Department @relation("AdmissionCoordinationDepartment", fields: [departmentId], references: [id], onDelete: Cascade)
  assignedHodUserId  String
  assignedHod        User       @relation("AdmissionCoordinationHod", fields: [assignedHodUserId], references: [id], onDelete: Cascade)
  status             String     @default("ASSIGNED")
  dueAt              DateTime
  submittedAt        DateTime?
  responseNotes      String?
  responseFiles      String?    @default("[]") // JSON string
  reviewedById       String?
  reviewedBy         User?      @relation("AdmissionCoordinationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewRemarks      String?
  createdById        String
  createdBy          User       @relation("AdmissionCoordinationCreator", fields: [createdById], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([departmentId])
  @@index([assignedHodUserId])
  @@index([status])
  @@index([createdById])
  @@map("admission_coordination_requests")
}







