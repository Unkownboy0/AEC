  beforeJson  String?
  afterJson   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([closingId, createdAt])
  @@map("daily_closing_approvals")
}

model FinanceRequest {
  id              String   @id @default(uuid())
  requestNumber   String   @unique
  requestType     String   // REFUND, CONCESSION, SCHOLARSHIP, ADJUSTMENT
  status          String   @default("REQUESTED")
