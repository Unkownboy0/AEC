  status      String    @default("ACTIVE") // ACTIVE, INACTIVE
  bills       FeeBill[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

