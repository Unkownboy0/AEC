model CertificateTemplate {
  id             String   @id @default(uuid())
  name           String   @unique
  code           String   @unique
  type           String   // BONAFIDE, STUDY, CONDUCT, TC, FEE, SCHOLARSHIP, CUSTOM
  content        String   // HTML/template with placeholders
  headerHtml     String?
  footerHtml     String?
  signatories    String   @default("[]") // JSON: [{role, name, designation}]
  requiresFinancialClearance Boolean @default(false)
  requiresApproval Boolean @default(true)
  autoFields     String   @default("[]") // JSON: fields auto-pulled from Student Master
  status         String   @default("ACTIVE")
  version        Int      @default(1)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  generations    CertificateGeneration[]

  @@map("certificate_templates")
}

model CertificateGeneration {
  id              String    @id @default(uuid())
  requestNumber   String    @unique
  templateId      String
  template        CertificateTemplate @relation(fields: [templateId], references: [id])
  studentId       String
  requestedById   String
  purpose         String?
  data            String    @default("{}") // JSON: merged data from Student Master
  status          String    @default("REQUESTED") // REQUESTED, UNDER_REVIEW, FINANCIAL_CLEARANCE, APPROVED, GENERATED, SIGNED, PUBLISHED, REJECTED, RETURNED
  currentStep     String    @default("OFFICE_REVIEW")
  qrVerificationHash String? @unique
  generatedPdfUrl String?
  signedPdfUrl    String?
  signedAt        DateTime?
  signedById      String?
  publishedAt     DateTime?
  rejectionReason String?
  returnReason    String?
  turnaroundHours Float?
  financialClearance Boolean @default(false)
  financialClearanceAt DateTime?
  financialClearanceBy String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([studentId, status])
  @@index([templateId])
  @@index([status, createdAt])
  @@map("certificate_generations")
}

