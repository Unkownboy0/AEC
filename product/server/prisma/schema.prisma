  status                String    @default("PENDING_MENTOR") // DRAFT, PENDING_MENTOR, RETURNED_TO_STUDENT, REJECTED_BY_MENTOR, PENDING_HOD, RETURNED_TO_MENTOR, REJECTED_BY_HOD, PENDING_DEAN, APPROVED, CANCELLED, EXPIRED
