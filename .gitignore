# Dependency directories
node_modules/
product/client/node_modules/
product/server/node_modules/

# Build outputs
dist/
build/
releases/
*.apk
product/client/dist/
product/client/dist-mobile/
product/client/android/app/build/
product/server/dist/
product/server/uploads/

# Local databases and journals
*.db
*.db-journal
product/server/prisma/dev.db
product/server/prisma/dev.db-journal

# Logs
*.log
logs/
product/server/logs/

# Environment files
.env
.env.*
!.env.example
!*.example
!**/*.example
!**/.env.*.example
!local-server-hosting/.env.local-server.example
.env.local
.env.*.local

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets & Service Accounts
*service-account*.json
*adminsdk*.json
*firebase*.json
firebase-*.json

# User-uploaded runtime content (profile photos, resumes, ID cards, circular
# attachments, etc). These are generated at runtime per deployment and must
# never be committed — some contain real personal data.
product/server/uploads/*
!product/server/uploads/.gitkeep
